{
  "expo": {
    "name": "EngliCards",
    "slug": "EngliCards",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oweenunda.englicards"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.oweenunda.englicards",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app accede a tus fotos para que puedas seleccionar imágenes para tus tarjetas.",
          "cameraPermission": "La app accede a la cámara para tomar fotos para tus tarjetas.",
          "microphonePermission": "La app accede al micrófono al grabar videos."
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#231F7C",
          "defaultChannel": "default",
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-audio"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "8269d921-ae54-428b-9ed0-0b04412f0b75"
      }
    },
    "owner": "jaisonstv"
  }
}
